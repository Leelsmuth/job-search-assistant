# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local direct Postgres (port 5432).
# Vercel runtime prefers POSTGRES_URL — the Supabase transaction pooler (port 6543).
# drizzle-kit (db:push / db:migrate) prefers POSTGRES_URL_NON_POOLING, then this direct URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# OpenAI (optional). Without a key, resume tailoring is selection-only and cover letters use a template.
OPENAI_API_KEY=sk-your-key
# Chat model for every OpenAI call. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily digest (optional). Without RESEND_API_KEY the in-app /digest page still works.
# Resend's free tier can send from onboarding@resend.dev to the address on the Resend account.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=Job Search <onboarding@resend.dev>
